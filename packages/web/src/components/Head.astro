---
import Default from '@astrojs/starlight/components/Head.astro'

const slug = Astro.url.pathname.replace(/^\//, "").replace(/\/$/, "");
const {
  entry: {
    data: { title },
  },
} = Astro.locals.starlightRoute;
const t = Astro.locals.t as (key: string) => string
const titleSuffix = t("app.head.titleSuffix")
const shareSlug = "docs/s"
const isShare = slug === shareSlug || slug.startsWith(`${shareSlug}/`)
const isHome = slug === "" || slug === "docs"

const ogImage = "https://openctrlc.pages.dev/social-share.svg";
---

{ isHome && (
<title>{title} | {titleSuffix}</title>
)}

<Default {...Astro.props}><slot /></Default>

{ !isShare && (
  <meta property="og:image" content={ogImage} />
  <meta property="twitter:image" content={ogImage} />
)}
